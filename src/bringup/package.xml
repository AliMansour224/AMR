<?xml version="1.0"?>
<package format="3">
  <name>bringup</name>
  <version>0.0.1</version>
  <description>Top-level launch package for AMR autonomy system modes.</description>

  <maintainer email="ahmedlearningfinnish@gmail.com">Ahmed</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>bridge</exec_depend>
  <exec_depend>simulation</exec_depend>
  <exec_depend>localization</exec_depend>
  <exec_depend>navigation</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
