<?xml version="1.0"?>
<robot name="amr_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
  </link>
  <link name="lidar_link"/>
  <link name="imu_link"/>
  <link name="camera_link"/>
  <link name="ultrasonic_link"/>
  <link name="ir_link"/>

  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.20 0.0 0.20" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_ultrasonic" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.3 0.0 0.05" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_ir" type="fixed">
    <parent link="base_link"/>
    <child link="ir_link"/>
    <origin xyz="0.3 0.1 0.05" rpy="0 0 0"/>
  </joint>

</robot>