<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="adc_track_v1">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- OUTER BOUNDARY -->
    <model name="outer_right">
      <static>true</static>
      <pose>5.8 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 11.0 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 11.0 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="outer_top">
      <static>true</static>
      <pose>0.8 5.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.0 0.15 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.0 0.15 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="outer_left">
      <static>true</static>
      <pose>-4.8 0.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 9.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 9.6 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="outer_bottom">
      <static>true</static>
      <pose>0.3 -5.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.3 0.15 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.3 0.15 0.4</size></box></geometry></visual>
      </link>
    </model>

    <!-- INNER BOUNDARY -->
    <model name="inner_right">
      <static>true</static>
      <pose>3.8 0.4 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.4 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.4 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_top">
      <static>true</static>
      <pose>0.4 3.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.6 0.15 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.6 0.15 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_left">
      <static>true</static>
      <pose>-3.2 -0.2 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 7.6 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 7.6 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_bottom_left">
      <static>true</static>
      <pose>-1.5 -3.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.5 0.15 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.5 0.15 0.4</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_bottom_right">
      <static>true</static>
      <pose>2.2 -3.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.8 0.15 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.8 0.15 0.4</size></box></geometry></visual>
      </link>
    </model>

    <!-- START / STOP / FINISH LINES -->
    <model name="start_line">
      <static>true</static>
      <pose>5.0 -4.3 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.4 0.15 0.02</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="stop_line">
      <static>true</static>
      <pose>0.4 -4.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.4 0.15 0.02</size></box></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="finish_line">
      <static>true</static>
      <pose>4.4 -4.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.4 0.15 0.02</size></box></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- STATIC OBSTACLE AVOIDANCE ZONE -->
    <model name="adc_obstacle_1">
      <static>true</static>
      <pose>-0.6 -4.45 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.225</radius><length>1.10</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.225</radius><length>1.10</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="adc_obstacle_3">
      <static>true</static>
      <pose>2.2 -4.35 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.225</radius><length>1.10</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.225</radius><length>1.10</length></cylinder></geometry>
          <material><ambient>0.1 0.3 0.9 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>